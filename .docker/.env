# Docker Compose Project Name (used for naming networks, volumes)
COMPOSE_PROJECT_NAME=myhelloworld

# Image versions/tags
FE_IMAGE_TAG_BLUE=blue
FE_IMAGE_TAG_GREEN=green
BE_IMAGE_TAG_BLUE=blue
BE_IMAGE_TAG_GREEN=green

# DockerHub Username/ID (replace with your actual DockerHub ID)
DOCKERHUB_ID=yourdockerhubid

# Frontend Nuxt3 App
NUXT_PUBLIC_API_BASE_URL=/api

# Backend Spring Boot App specific to blue (overridden in green.yml context)
# SERVER_NAME_BLUE=server-blue (This will be set in compose file directly)
# SERVER_NAME_GREEN=server-green (This will be set in compose file directly)

# MySQL
MYSQL_DATABASE=mydatabase
MYSQL_USER=myuser
MYSQL_PASSWORD=mypassword
MYSQL_ROOT_PASSWORD=root123
MYSQL_PORT=3306

# Nginx
NGINX_PORT=80
